{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Blockscope",
  "colors": {
    "primary": "#16A34A",
    "light": "#4ADE80",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "navbar": {
          "primary": {
            "type": "github",
            "label": "GitHub",
            "href": "https://github.com/Linvin-1233/Blockscope"
          }
        },
        "footer": {
          "socials": {
            "github": "https://github.com/Linvin-1233/Blockscope"
          }
        },
        "tabs": [
          {
            "tab": "User Guide",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "index",
                  "user/index",
                  "user/getting-started",
                  "user/features",
                  "user/cli"
                ]
              },
              {
                "group": "Guides & Operations",
                "pages": [
                  "user/materials",
                  "user/service",
                  "user/docker",
                  "user/cloudflare-workers"
                ]
              },
              {
                "group": "Reference",
                "pages": ["user/limits", "user/troubleshooting"]
              }
            ]
          },
          {
            "tab": "Technical Specs",
            "groups": [
              {
                "group": "Pipeline Architecture",
                "pages": ["litematic-format", "mesh-geometry", "rendering", "textures"]
              },
              {
                "group": "System & Protocol",
                "pages": ["engine-protocol", "deployment"]
              }
            ]
          }
        ]
      },
      {
        "language": "zh",
        "navbar": {
          "primary": {
            "type": "github",
            "label": "GitHub",
            "href": "https://github.com/Linvin-1233/Blockscope"
          }
        },
        "footer": {
          "socials": {
            "github": "https://github.com/Linvin-1233/Blockscope"
          }
        },
        "groups": [
          {
            "group": "入门与概览",
            "pages": [
              "zh/index",
              "zh/user/index",
              "zh/user/getting-started",
              "zh/user/features",
              "zh/user/cli"
            ]
          },
          {
            "group": "进阶与部署",
            "pages": ["zh/user/materials", "zh/user/service", "zh/user/docker"]
          },
          {
            "group": "参考与排查",
            "pages": ["zh/user/limits", "zh/user/troubleshooting"]
          }
        ]
      }
    ]
  }
}
